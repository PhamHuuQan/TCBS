# ==============================================================================
# TDnook Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL LLM INFERENCE (IN-PROCESS DIRECT LOADING)
# Note: TDnook reads model weights directly into memory (RAM / GPU VRAM).
# You DO NOT need to run Ollama, LM Studio Server, or any external local API.
# ------------------------------------------------------------------------------

# --- [OPTION A] macOS (Apple Silicon M1/M2/M3/M4 via MLX Metal) ---
# Point to an MLX model folder (e.g. from LM Studio downloads or Hugging Face):
LOCAL_MODEL_PATH=/Users/your_username/.lmstudio/models/lmstudio-community/Qwen3.5-2B-MLX-4bit
LOCAL_MODEL_TYPE=qwen

# --- [OPTION B] Windows / Linux / Intel Mac (via llama-cpp GGUF) ---
# Point to a single .gguf model file:
# LOCAL_MODEL_PATH=C:\models\Qwen2.5-3B-Instruct-Q4_K_M.gguf
# LOCAL_MODEL_PATH=./models/gemma-4-E4B-it-Q4_K_M.gguf
# LOCAL_MODEL_TYPE=qwen

# Inference Parameters
MODEL_N_CTX=8192
MODEL_N_BATCH=512
MODEL_N_GPU_LAYERS=0      # Set > 0 (e.g. 33) for NVIDIA GPU acceleration on Windows/Linux
MODEL_N_THREADS=4         # CPU threads to allocate
MODEL_MAX_TOKENS=1024
MODEL_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# 2. EMBEDDINGS & VECTOR DATABASE
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
VECTOR_DB_PATH=./data/vector_db
TOP_K=5

# ------------------------------------------------------------------------------
# 3. DOCUMENT OCR SETTINGS
# ------------------------------------------------------------------------------
OCR_LANGUAGES=vi,en

# ------------------------------------------------------------------------------
# 4. CLOUD LLM (OPTIONAL FALLBACK)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. OFFICIAL TCBS REMOTE MCP (READ-ONLY)
# TCBS authenticates through OAuth 2.0. Never put your TCBS password/iOTP here.
# Supply only an OAuth access token if your approved MCP client provides one.
# ------------------------------------------------------------------------------
TCBS_MCP_ENABLED=true
TCBS_MCP_URL=https://mcp.tcbs.com.vn/mcp/tcinvest/
TCBS_MCP_ACCESS_TOKEN=
TCBS_MCP_TIMEOUT=30
TCBS_MCP_PROTOCOL_VERSION=2025-06-18

# Local OAuth callback used by the built-in TCBS Connect button
TCBS_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/tcbs/oauth/callback


# ------------------------------------------------------------------------------
# 6. TELEGRAM BOT / RAILWAY
# ------------------------------------------------------------------------------
# Bot token from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to use this private bot.
# Start the deployed bot and send /id once to discover your ID.
TELEGRAM_ALLOWED_USER_IDS=
# Recommended: stable secret for Telegram webhook header/path.
# Leave empty to derive a stable non-reversible token hash automatically.
TELEGRAM_WEBHOOK_SECRET=
# Optional. Railway can derive the webhook from RAILWAY_PUBLIC_DOMAIN automatically.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_DB_PATH=/data/tcbs_telegram.db
TELEGRAM_DOCUMENT_DIR=/data/documents
TELEGRAM_MAX_DOWNLOAD_MB=20
TELEGRAM_ALERT_POLL_SECONDS=300

# ------------------------------------------------------------------------------
# 7. CLOUD AI FOR B1 (RAILWAY-ONLY)
# ------------------------------------------------------------------------------
# Gemini REST API. Google currently documents Gemini 3.5 Flash-Lite and 3.8 Flash
# among its current models; keep the primary/fallback list configurable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash
GEMINI_TIMEOUT=90
GEMINI_MAX_OUTPUT_TOKENS=1400
GEMINI_TEMPERATURE=0.2
